# ============================================================================
# Configuration — Plateforme de Gestion Immobilière
# Copier en .env et renseigner. Ne JAMAIS committer le .env réel.
# Auteur : DIABATE Oumarou — DATACONNECT AFRICA · 05 août 2026
# ============================================================================

NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3001

# --- Base de données --------------------------------------------------------
DATABASE_URL="postgresql://immo:immo@localhost:5432/immo?schema=public"

# --- Redis (cache, files BullMQ, limitation de débit) -----------------------
REDIS_URL="redis://localhost:6379"

# --- Jetons -----------------------------------------------------------------
# Générer : openssl rand -base64 48
JWT_SECRET="a-remplacer-en-production"
JWT_REFRESH_SECRET="a-remplacer-en-production-different-du-precedent"

# --- Chiffrement applicatif des données sensibles (AES-256-GCM) -------------
# 32 octets en base64 : openssl rand -base64 32
# En production, cette clé provient du KMS — jamais d'un fichier.
CLE_CHIFFREMENT=""

# --- Agrégateur de paiement (à renseigner après le POC de phase 0) ----------
PSP_FOURNISSEUR="cinetpay"
PSP_API_KEY=""
PSP_SITE_ID=""
PSP_WEBHOOK_SECRET=""

# --- SMS (double fournisseur : les OTP sont critiques) ----------------------
SMS_FOURNISSEUR_PRIMAIRE="console"
SMS_FOURNISSEUR_SECOURS=""
SMS_API_KEY=""
SMS_SENDER_ID="IMMO"

# --- Stockage objet ---------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET_PUBLIC="immo-photos"
S3_BUCKET_PRIVE="immo-documents"
S3_ACCESS_KEY=""
S3_URL_PUBLIQUE=""   # adresse vue par les navigateurs (CDN en production)
S3_REGION="us-east-1"
S3_SECRET_KEY=""
S3_CHIFFREMENT_SERVEUR="true"   # false en dev (MinIO sans KMS)
